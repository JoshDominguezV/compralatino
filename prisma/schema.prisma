generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  OPERATOR
}

enum OrderStatus {
  PENDING
  PAID
  EXECUTED_IN_JAPAN
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum BidStatus {
  PLACED
  WON
  LOST
  CANCELLED
}

model User {
  id              String                  @id @default(uuid())
  name            String?
  email           String                  @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            UserRole                @default(USER)
  mfaEnabled      Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  profile         CustomerProfile?
  bids            BidTransaction[]
  orders          Order[]
  recommendations RecommendationMetric[]
  auditLogs       AuditLog[]
  accounts        Account[]
  sessions        Session[]
}

model CustomerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  shippingAddress String   @default("")
  taxId           String?
  phone           String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExternalProduct {
  id                String      @id @default(uuid())
  externalAuctionId String      @unique
  title             String
  description       String      @db.Text
  priceJpy          Decimal     @db.Decimal(12, 2)
  category          String
  condition         String      @default("Muy bueno")
  imageUrl          String
  seller            String      @default("Vendedor verificado")
  endAt             DateTime?
  isBuyNow          Boolean     @default(false)
  isActive          Boolean     @default(true)
  isFeatured        Boolean     @default(false)
  createdAt         DateTime    @default(now())
  orders            OrderItem[]
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    String      @default("USD")
  paymentRef  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  externalProductId String
  unitPrice         Decimal         @db.Decimal(12, 2)
  quantity          Int             @default(1)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           ExternalProduct @relation(fields: [externalProductId], references: [id])
}

model BidTransaction {
  id        String    @id @default(uuid())
  userId    String
  auctionId String
  bidAmountJpy Decimal @map("bidAmount") @db.Decimal(12, 2)
  status    BidStatus @default(PLACED)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([auctionId, status])
}

model RecommendationMetric {
  id             String   @id @default(uuid())
  userId         String
  category       String
  affinityWeight Decimal  @default(0) @db.Decimal(8, 4)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, category])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  eventType     String
  correlationId String
  details       Json?
  occurredAt    DateTime @default(now())
  user          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([correlationId])
  @@index([occurredAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
